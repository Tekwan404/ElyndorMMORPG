{
  "Authentication": {
    "Issuer": "Elyndor.Server",
    "Audience": "Elyndor.TelegramMiniApp",
    "Telegram": {
      "InitDataMaxAgeSeconds": 300,
      "MaxFutureSkewSeconds": 30
    },
    "Development": {
      "Enabled": false,
      "TelegramUserId": 0
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
